# shellcheck shell=bash
# The binaryen release whose wasm-opt shrinks the embed module. One place for the version and the
# checksum: install-binaryen.sh (CI) installs it and package.sh refuses any other wasm-opt, since
# the optimiser's output is part of the zip's bytes. The hash is the one in the release's own
# .sha256 asset for the x86_64 Linux build, cross-checked by hashing the tarball.
BINARYEN_VERSION="123"
BINARYEN_LINUX_X86_64_SHA256="e959f2170af4c20c552e9de3a0253704d6a9d2766e8fdb88e4d6ac4bae9388fe"
