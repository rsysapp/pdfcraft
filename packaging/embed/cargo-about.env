# shellcheck shell=bash
# The cargo-about release that writes THIRD-PARTY-LICENSES.txt. One place for the version and the
# checksum: install-cargo-about.sh (CI) and third-party-licenses.sh (which refuses any other
# version, since the tool's licence texts and its choice among "A OR B" licences come with it) read
# them. The hash is the one in the release's own .sha256 asset for the x86_64 Linux build,
# cross-checked by hashing the tarball.
CARGO_ABOUT_VERSION="0.9.2"
CARGO_ABOUT_LINUX_X86_64_SHA256="9099a59e820c38a68b9d65f300662a567d56562f9a10f6aa4c7e86c17c2566af"
